# -----------------------------------------------------------------------------
# Ficheros de trabajo que no aportan nada a quien se descargue esto
# -----------------------------------------------------------------------------
# Son volcados intermedios y resultados que `make` vuelve a generar solo.
#
# Ojo con la forma de escribirlo: 'work/' a secas excluiria el directorio entero
# y entonces el '!work/msx.sym' de abajo NO podria rescatar nada, porque git no
# vuelve a mirar dentro de un directorio ya excluido. Con 'work/*' si funciona.

extracted/
dump/
build/
work/*
!work/msx.sym

# -----------------------------------------------------------------------------
# El reproductor PT3
# -----------------------------------------------------------------------------
# Tampoco se distribuye: es de Bulba / Dioniso / msxKun / SapphiRe y viaja en
# msx-msxlib sin licencia escrita. Lo que si va aqui es tools/convierte_pt3.py,
# que lo traduce de asMSX a pasmo, y `make src/cartucho/pt3_player.asm` lo
# genera de tu copia. La musica (.pt3) es de su autor y tampoco viaja.
src/cartucho/pt3_player.asm
*.pt3

# -----------------------------------------------------------------------------
# La cinta original
# -----------------------------------------------------------------------------
# No se distribuye la imagen de cinta: cada cual pone la suya. Los listados
# comentados SI van incluidos (ver AVISO-LEGAL.md).

*.tsx
*.cas
*.wav
*.rom
*.dsk

# -----------------------------------------------------------------------------
# Basura del sistema y del entorno
# -----------------------------------------------------------------------------
.DS_Store
__pycache__/
*.pyc
.forja/
*.omr
