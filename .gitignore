# -----------------------------------------------------------------------------
# Ficheros de trabajo que no aportan nada a quien se descargue esto
# -----------------------------------------------------------------------------
# Son volcados intermedios y resultados que `make` vuelve a generar solo.
#
# Ojo con la forma de escribirlo: 'work/' a secas excluiria el directorio entero
# y entonces el '!work/msx.sym' de abajo NO podria rescatar nada, porque git no
# vuelve a mirar dentro de un directorio ya excluido. Con 'work/*' si funciona.

extracted/
dump/
build/
work/*
!work/msx.sym

# -----------------------------------------------------------------------------
# El reproductor PT3
# -----------------------------------------------------------------------------
# Tampoco se distribuye: el reproductor es el WYZ PSG proPLAYER v0.47d, de Wyz,
# y viaja en msx-msxlib sin licencia escrita. Lo que si va aqui es
# tools/convierte_wyz.py, que lo traduce de tniASM a pasmo, y
# `make src/cartucho/wyz_player.asm` genera de tu copia el reproductor y el
# .inc con sus variables. La cancion (.mus y su .mus.asm) es de su autor y
# tampoco viaja.
src/cartucho/wyz_player.asm
src/cartucho/wyz_trabajo.inc
*.mus
*.mus.asm

# -----------------------------------------------------------------------------
# La cinta original
# -----------------------------------------------------------------------------
# No se distribuye la imagen de cinta: cada cual pone la suya. Los listados
# comentados SI van incluidos (ver AVISO-LEGAL.md).

*.tsx
*.cas
*.wav
*.rom
*.dsk

# -----------------------------------------------------------------------------
# Basura del sistema y del entorno
# -----------------------------------------------------------------------------
.DS_Store
__pycache__/
*.pyc
.forja/
*.omr

# El material de Ruben (pantallas .SC2 y canciones): es SUYO y no se publica hasta
# que el lo diga. `make war_unificada.rom` lo lee de aqui igual.
asses/
